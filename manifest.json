{
  "name": "Intlx Asset Manager",
  "author": {
    "name": "Intlx Solutions",
    "email": "rob.johnston@intlxsolutions.com"
  },
  "defaultLocale": "en",
  "version": "2.4.1",
  "frameworkVersion": "2.0",
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/index.html",
        "size": {
          "width": 400,
          "height": 700
        }
      }
    }
  },
  "domainWhitelist": [
    "intlxassetmgr-proxy.onrender.com"
  ],
  "logo": {
    "app": "assets/logo-small.png",
    "brand": "assets/logo.png"
  },
  "ignore": [
    "node_modules",
    "webpack.config.js",
    "*.log",
    "*.md",
    ".gitignore",
    "package.json",
    "package-lock.json"
  ],
  "parameters": [
    {
      "name": "shared_secret",
      "type": "text",
      "required": true,
      "secure": true
    }
  ]
}
